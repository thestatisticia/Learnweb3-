# LearnWeb3 — Environment Variables

# Privy (required) — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Groq LLM (free) — https://console.groq.com/keys
GROQ_API_KEY=

# EVM faucet hot wallet (required for Base + Celo funding in chat)
FAUCET_PRIVATE_KEY=0xyour-faucet-private-key

# LearnWeb3Progress contract (Base Sepolia) — npm run contract:deploy
NEXT_PUBLIC_PROGRESS_CONTRACT=
NEXT_PUBLIC_PROGRESS_CHAIN_ID=84532

# LearnWeb3Badge NFT (Base Sepolia) — npm run contract:deploy-badge
NEXT_PUBLIC_BADGE_CONTRACT=

# LearnTokenSwap practice swap contract (Base Sepolia) — npm run contract:deploy-swap
NEXT_PUBLIC_SWAP_CONTRACT=

# Mission send recipient (defaults to faucet deployer if unset)
NEXT_PUBLIC_MISSION_RECIPIENT=
