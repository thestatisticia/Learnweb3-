# LearnWeb3 — Environment Variables

# Privy (required) — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# Groq LLM (free) — https://console.groq.com/keys
# Required for real AI conversation in chat
GROQ_API_KEY=

# EVM faucet hot wallet (required for Base + Celo funding in chat)
# Generate with: node -e "const {generatePrivateKey,privateKeyToAccount}=require('viem/accounts'); const k=generatePrivateKey(); console.log(k, privateKeyToAccount(k).address)"
# Then deposit Base Sepolia ETH + Celo Sepolia CELO to that address
FAUCET_PRIVATE_KEY=0xyour-faucet-private-key

# LearnWeb3Progress contract (Ethereum Sepolia)
NEXT_PUBLIC_PROGRESS_CONTRACT=
NEXT_PUBLIC_PROGRESS_CHAIN_ID=11155111
